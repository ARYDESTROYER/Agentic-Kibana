{
  "name": "agentic-soc-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone, vendor-agnostic web UI for the Agentic SOC triage backend (replaces the Kibana plugin).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "postinstall": "node scripts/patch-eui-icons.cjs"
  },
  "dependencies": {
    "@elastic/eui": "95.12.0",
    "@emotion/css": "11.13.5",
    "@emotion/react": "11.14.0",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "moment": "2.30.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
