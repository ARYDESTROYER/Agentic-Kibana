{
  "name": "agentic-soc-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone, vendor-agnostic web UI for the Agentic SOC triage backend (replaces the Kibana plugin).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "postinstall": "node scripts/patch-eui-icons.cjs"
  },
  "dependencies": {
    "@elastic/eui": "95.12.0",
    "@emotion/css": "11.13.5",
    "@emotion/react": "11.14.0",
    "moment": "2.30.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
