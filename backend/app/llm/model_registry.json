    "capabilities": ["chat", "tools", "json", "reasoning", "embedding", "vision", "cache"],
    "input_per_million": "USD / 1M input tokens",
    "output_per_million": "USD / 1M output tokens",
    "cache_write_per_million": "USD / 1M cache-write tokens (optional)",
    "cache_read_per_million": "USD / 1M cache-read tokens (optional)",
    "base_url": "optional OpenAI-compatible endpoint base (vLLM/Ollama/OpenRouter/...)"
