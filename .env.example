# =============================================================================
# TLSOC Agentic Triage Suite — environment template.
#
# Copy to `.env` in the TLSOCDockerDeploy directory (next to docker-compose.yml)
# and fill in. NEVER commit the real .env. All secrets live here / in the
# environment only — never in the plugin, never in any Elasticsearch index.
#
# These TLSOC_* names are read by the compose block in deploy/docker-compose.tlsoc.yml
# and mapped into the backend container's own env vars.
# =============================================================================

# --- Elasticsearch credentials (TWO scoped API keys; NEVER the superuser) ------
# 1) Read-only key, scoped to your log indices. The agent uses ONLY this to read
#    logs. Mint in Kibana: Stack Management > Security > API keys > Create API key,
#    choose "Restrict privileges", and paste this role descriptor:
#      {
#        "tlsoc_agent_readonly": {
#          "indices": [
#            { "names": ["all-logs-*"], "privileges": ["read","view_index_metadata"] }
#          ]
#        }
#      }
TLSOC_ES_API_KEY=

# 2) Management key, scoped to the suite's OWN indices only (read/write/create).
#    The backend uses this to own its cases/audit/usage/config/cursor indices.
#    Role descriptor:
#      {
#        "tlsoc_agent_mgmt": {
#          "indices": [
#            { "names": ["tlsoc-agent-*"],
#              "privileges": ["read","write","create_index","view_index_metadata","manage"] }
#          ]
#        }
#      }
TLSOC_ES_MGMT_API_KEY=

# --- LLM providers (configure at least one) -----------------------------------
TLSOC_ANTHROPIC_API_KEY=
TLSOC_OPENAI_API_KEY=

# --- Enrichment providers (optional; enrichment degrades gracefully without) ---
TLSOC_ABUSEIPDB_API_KEY=
TLSOC_VIRUSTOTAL_API_KEY=

# --- Embeddings for RAG (optional; falls back to local hashing embeddings) -----
# If blank, the OpenAI key above is used for embeddings.
TLSOC_EMBEDDING_API_KEY=

# --- OWN-state backend (where the suite stores cases/audit/usage/config/cursor) -
# Vendor-agnostic self-hosting (AGNOSTIC_ARCHITECTURE.md). The agent's READ-ONLY
# log surface ALWAYS uses the connector layer (TLSOC_ES_API_KEY) regardless of
# this — this only chooses where the suite's OWN bookkeeping lives:
#   elasticsearch (default) — tlsoc-agent-* indices via TLSOC_ES_MGMT_API_KEY.
#   postgres                — PostgreSQL (+pgvector for RAG); NO Elasticsearch needed.
#   sqlite                  — a local SQLite file (zero extra services; single-node).
# When postgres/sqlite, TLSOC_ES_MGMT_API_KEY is not required.
TLSOC_STATE_BACKEND=elasticsearch
# SQLAlchemy async URL for the SQL backends. Examples:
#   postgres: postgresql+asyncpg://tlsoc:password@tlsoc-postgres:5432/tlsoc
#   sqlite:   sqlite+aiosqlite:////data/tlsoc.db    (blank → ./tlsoc.db)
TLSOC_STATE_DB_URL=

# --- PostgreSQL (used ONLY by deploy/docker-compose.agnostic.yml) --------------
# The agnostic stack runs Postgres+pgvector for the app's own state and builds
# STATE_DB_URL automatically from these. TLSOC_PG_PASSWORD is REQUIRED there.
TLSOC_PG_USER=tlsoc
TLSOC_PG_PASSWORD=
TLSOC_PG_DB=tlsoc

# --- Log SOURCE cluster (optional; for an Elasticsearch/OpenSearch/Wazuh source)
# A read-only key + URL for the cluster you read logs FROM. You can also enter
# these in the first-run wizard. Per-source field mapping is set in the wizard;
# these just point at the cluster. (TLSOC_ES_API_KEY above is reused as the
# read-only log key.) For a private CA, mount it and set TLSOC_ES_CA_CERT.
TLSOC_ES_URL=
TLSOC_ES_CA_CERT=
TLSOC_ES_VERIFY_CERTS=true

# --- Cache (optional) ----------------------------------------------------------
# Leave default to use the bundled tlsoc-redis service; set empty to force the
# in-memory cache fallback.
TLSOC_REDIS_URL=redis://tlsoc-redis:6379/0

# --- Logging -------------------------------------------------------------------
TLSOC_LOG_LEVEL=INFO

# --- API auth + RBAC + MFA + SSO (default OFF — the no-auth deployment is fully
# supported and unchanged out of the box). See SECURITY.md "Optional API
# authentication" + "RBAC / MFA / SSO", DEMO.md, and DEPLOY.md §9. ---
#
# ╔═══ DEMO / QUICK START ════════════════════════════════════════════════════╗
# ║ Set TLSOC_AUTH_ENABLED=true to enable the LOGIN screen + 6-role RBAC +     ║
# ║ MFA + SSO. When auth is enabled AND the user store is empty, the backend  ║
# ║ AUTO-SEEDS a demo super_admin:   Admin / Admin@123                         ║
# ║ (change it immediately for any real use). The committed default below     ║
# ║ stays FALSE so the out-of-the-box / test experience is unchanged.         ║
# ║ scripts/run-demo.sh enables auth + a dev JWT secret for you.              ║
# ╚════════════════════════════════════════════════════════════════════════════╝
TLSOC_AUTH_ENABLED=false
# HS256 session-signing key. Set a STABLE 32+ byte secret, else it is ephemeral
# and ALL sessions die on every backend restart. e.g. `openssl rand -hex 32`.
TLSOC_AUTH_JWT_SECRET=
# Env single-admin fallback (separate from the auto-seeded demo super_admin
# above): username + plaintext password (hashed in memory at startup, never
# stored). Granted super_admin. Optional once you create users in the UI.
TLSOC_AUTH_ADMIN_USERNAME=admin
TLSOC_AUTH_ADMIN_PASSWORD=
# Optional multi-user map (username -> PBKDF2 hash) supplied at boot:
# TLSOC_AUTH_USERS={"alice":"pbkdf2_sha256$...","bob":"pbkdf2_sha256$..."}
TLSOC_AUTH_USERS={}
TLSOC_AUTH_TOKEN_HOURS=12
TLSOC_AUTH_COOKIE_SECURE=false        # set true behind TLS (HTTPS-only cookie)
#
# RBAC: 6 roles — super_admin / soc_manager / analyst_tier2 / analyst_tier1 /
# responder / auditor — enforced server-side (require_permission) + in the UI
# (<Can> guards). When auth is OFF every user is treated as super_admin.
#
# MFA (per-user opt-in RFC-6238 TOTP, inline-SVG QR, single-use recovery codes).
# The per-user TOTP secret is OBFUSCATED at rest with this key; leave BLANK to
# derive it from TLSOC_AUTH_JWT_SECRET. NOTE: stdlib obfuscation, NOT a KMS
# (hardening TODO — see SECURITY.md / auth/mfa.py).
TLSOC_MFA_OBFUSCATION_KEY=
#
# SSO (OIDC; Google / Microsoft / generic). Providers are configured in Settings
# (issuer/client-id/redirect); their CLIENT SECRETS stay in the SECRET tier. Set
# as a JSON object keyed by provider id, e.g.
# TLSOC_SSO_CLIENT_SECRETS={"google":"GOCSPX-...","corp":"..."} — or push at runtime
# via POST /api/auth/sso/providers/{id}/secret (super_admin). The redirect/callback
# URI to register with the IdP is  <base-url>/api/auth/sso/callback . Group->role
# provisioning maps IdP groups onto the 6 roles. (id_token signature-verify is a
# documented hardening TODO — server-side code-exchange + userinfo today.)
TLSOC_SSO_CLIENT_SECRETS={}
#
# Opt-in hardening middleware (independent of auth):
TLSOC_SECURITY_HEADERS_ENABLED=true
TLSOC_RATE_LIMIT_ENABLED=false
TLSOC_CSRF_ENABLED=false              # requires API clients to send X-CSRF-Token

# --- Notifications (default OFF; channels configured in Settings). The channel
# SECRET (SMTP password / Slack/Teams/webhook URL / PagerDuty/Telegram token)
# lives in the SECRET tier — set via the UI / POST /api/notifications/channels/
# {id}/secret, or seed at boot here as a JSON map of channel id -> {field: value}.
# Email is stdlib SMTP with 13 provider presets. e.g.
# TLSOC_NOTIFICATION_SECRETS={"email-ops":{"secret":"<smtp-password>"},"slack-soc":{"secret":"https://hooks.slack.com/services/..."}}
# See DEPLOY.md §10 (Notifications) for SMTP/Slack setup.
TLSOC_NOTIFICATION_SECRETS={}
